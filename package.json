{
  "name": "road-to-bis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm run install-engine-deps",
    "install-engine-deps": "node scripts/install-engine-deps.mjs",
    "fetch-restricted-items": "node scripts/fetch-restricted-items.mjs",
    "fetch-recipes": "node scripts/fetch-recipes.mjs",
    "benchmark": "BENCHMARK=1 vitest run benchmark",
    "fetch-recommended-equipment": "node scripts/fetch-recommended-equipment.mjs",
    "path-check": "PATH_CHECK=1 vitest run path-check"
  },
  "dependencies": {
    "ky": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.0.0"
  }
}
